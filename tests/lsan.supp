# LeakSanitizer suppressions for the X11 / Xft / fontconfig stack.
#
# These libraries allocate process-lifetime caches (atom tables, font pattern
# caches, config databases) that are never freed by design -- LSan reports them
# as leaks on every run. Suppressing them here keeps a real leak in wm2's own
# code visible instead of buried under third-party noise.
#
# REQUIRED companion setting (see tests/support/WmFixture.h::sanitizerEnv):
#   LSAN_OPTIONS=...:fast_unwind_on_malloc=0
# Without it the stripped system-library frames never appear in the recorded
# stack trace, so none of these patterns ever match and the suppressions are
# silently inert.

leak:libX11.so
leak:libXft.so
leak:libfontconfig
leak:FcFontSet
leak:FcPatternObject
